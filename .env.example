# Copy this file to .env and fill in the values you have.
# .env is git-ignored — real values never get committed.

# Plausible Analytics (https://plausible.io) — cookieless, GDPR-friendly,
# no consent banner required. Create a site there for your domain, then set
# this to that domain (e.g. sinerisgroup.com). Leave empty to ship with no
# analytics at all.
PUBLIC_PLAUSIBLE_DOMAIN=
