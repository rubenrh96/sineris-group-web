---
const values = [
  {
    title: 'Innovación',
    description: 'Ingredientes de vanguardia desarrollados para las necesidades cambiantes de la industria alimentaria.',
    path: 'M12 3v2.2M12 18.8V21M4.9 4.9l1.55 1.55M17.55 17.55l1.55 1.55M3 12h2.2M18.8 12H21M4.9 19.1l1.55-1.55M17.55 6.45l1.55-1.55M9 15.5A4.5 4.5 0 1 1 15 15.5c-.6.6-1 1.3-1 2.1v.4H10v-.4c0-.8-.4-1.5-1-2.1Z',
  },
  {
    title: 'Calidad',
    description: 'Supervisión analítica constante en laboratorio propio y con verificación externa independiente.',
    path: 'M12 3l7 3v5.2c0 4.4-3 8.3-7 9.8-4-1.5-7-5.4-7-9.8V6l7-3Zm-3 9 2.2 2.2L15.5 9.8',
  },
  {
    title: 'Servicio técnico',
    description: 'Soporte personalizado y soluciones a medida, desde la formulación hasta la logística.',
    path: 'M4 13.5A8 8 0 0 1 20 13.5M4 13.5v3a2 2 0 0 0 2 2h1v-6H5a1 1 0 0 0-1 1Zm16 0v3a2 2 0 0 1-2 2h-1v-6h1a1 1 0 0 1 2 1Zm-5 5.5v.3a1.7 1.7 0 0 1-1.7 1.7h-1.6a1.7 1.7 0 0 1-1.7-1.7v-.3',
  },
  {
    title: 'Sostenibilidad',
    description: 'Materias primas seleccionadas y procesos de fabricación con criterios de eficiencia responsables.',
    path: 'M6 20.5c8-1 11-6.5 11-14.5-7.5 0-13 3.5-13 11 0 1.3.2 2.5.6 3.5M6 20.5c0-3.5 1.7-6.7 4.3-9',
  },
] as const;
---

<section class="section section--surface values" aria-labelledby="values-heading">
  <h2 id="values-heading" class="visually-hidden">Por qué elegirnos</h2>
  <ul class="wrap values__grid">
    {
      values.map((value) => (
        <li class="values__item" data-reveal>
          <svg class="values__icon" width="30" height="30" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d={value.path} stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <h3>{value.title}</h3>
          <p>{value.description}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .values {
    border-block: 1px solid var(--border);
  }

  .values__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(2rem, 4vw, 3rem);
  }

  .values__item {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .values__icon {
    color: var(--accent);
    margin-bottom: 0.35rem;
  }

  .values__item h3 {
    font-size: 1.15rem;
  }

  .values__item p {
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .values__grid {
      grid-template-columns: repeat(2, 1fr);
      row-gap: 2.5rem;
    }
  }

  @media (max-width: 540px) {
    .values__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
