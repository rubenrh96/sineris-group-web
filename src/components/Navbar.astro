---
import { Image } from 'astro:assets';
import { NAV_LINKS } from '../data/nav';
import icon from '../assets/brand/sineris-icon-mark.png';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href));
---

<header class="navbar">
  <div class="navbar__bar"></div>
  <div class="wrap navbar__inner">
    <a href="/" class="navbar__brand" aria-label="Sineris Group — Inicio">
      <span class="navbar__mark">
        <Image src={icon} alt="" width={64} height={64} />
      </span>
      <span class="navbar__name">Sineris<span class="navbar__name-suffix">.group</span></span>
    </a>

    <nav class="navbar__nav" aria-label="Navegación principal">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/contacto" class="btn navbar__cta">
      Solicitar cotización
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
          d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    </a>

    <button class="navbar__toggle" type="button" aria-expanded="false" aria-controls="mobile-nav">
      <span class="visually-hidden">Abrir menú</span>
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path d="M3 6h14M3 10h14M3 14h14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-nav" aria-label="Navegación móvil">
    <ul>
      {
        NAV_LINKS.map((link) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))
      }
      <li>
        <a href="/contacto" class="btn mobile-nav__cta">Solicitar cotización</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  .navbar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--border);
  }

  .navbar__bar {
    height: 3px;
    background: var(--ink);
  }

  .navbar__inner {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-block: 1.1rem;
  }

  .navbar__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--ink);
    margin-right: auto;
  }

  .navbar__mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.35rem;
    height: 2.35rem;
    border-radius: 7px;
    background: var(--ink);
    flex-shrink: 0;
  }

  .navbar__mark :global(img) {
    width: 68%;
    height: 68%;
    object-fit: contain;
  }

  .navbar__name {
    font-family: var(--font-display);
    font-size: 1.2rem;
    letter-spacing: -0.01em;
  }

  .navbar__name-suffix {
    color: var(--muted-soft);
    font-style: italic;
  }

  .navbar__nav ul {
    display: flex;
    align-items: center;
    gap: clamp(1.1rem, 2vw, 2rem);
  }

  .navbar__nav a {
    text-decoration: none;
    font-size: 0.95rem;
    color: var(--muted);
    padding-block: 0.3rem;
    border-bottom: 1px solid transparent;
    transition: color 0.25s var(--ease), border-color 0.25s var(--ease);
  }

  .navbar__nav a:hover,
  .navbar__nav a[aria-current='page'] {
    color: var(--ink);
    border-color: var(--ink);
  }

  .navbar__cta {
    padding: 0.7em 1.3em;
    font-size: 0.9rem;
  }

  .navbar__toggle {
    display: none;
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-s);
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 860px) {
    .navbar__nav,
    .navbar__cta {
      display: none;
    }

    .navbar__toggle {
      display: inline-flex;
    }

    .mobile-nav {
      display: block;
      max-height: 0;
      overflow: hidden;
      border-top: 1px solid transparent;
      transition: max-height 0.4s var(--ease);
    }

    .mobile-nav.is-open {
      max-height: 24rem;
      border-top-color: var(--border);
    }

    .mobile-nav ul {
      display: flex;
      flex-direction: column;
      padding: 0.5rem var(--gutter) 1.5rem;
      gap: 0.25rem;
    }

    .mobile-nav a {
      display: block;
      padding: 0.75rem 0;
      text-decoration: none;
      color: var(--ink);
      font-size: 1.05rem;
      border-bottom: 1px solid var(--border);
    }

    .mobile-nav__cta {
      margin-top: 0.75rem;
      text-align: center;
      justify-content: center;
      border-bottom: none !important;
    }
  }
</style>

<script>
  const toggle = document.querySelector('.navbar__toggle');
  const menu = document.getElementById('mobile-nav');

  toggle?.addEventListener('click', () => {
    const isOpen = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
  });

  menu?.querySelectorAll('a').forEach((link) =>
    link.addEventListener('click', () => {
      menu.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
    })
  );
</script>
