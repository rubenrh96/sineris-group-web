---
import SectionHeading from './SectionHeading.astro';
import ProductCard from './ProductCard.astro';
import { PRODUCTS, PRODUCT_CATEGORIES, type CategoryId } from '../data/products';

interface Props {
  category?: CategoryId;
  limit?: number;
  surface?: boolean;
  level?: 'h1' | 'h2';
  featuredSlugs?: string[];
}

const { category, limit, surface = false, level = 'h2', featuredSlugs } = Astro.props;

let items: typeof PRODUCTS;
let isPreview: boolean;
let meta: { eyebrow: string; title: string; lede: string };

if (featuredSlugs) {
  items = featuredSlugs
    .map((slug) => PRODUCTS.find((product) => product.slug === slug))
    .filter((product): product is (typeof PRODUCTS)[number] => Boolean(product));
  isPreview = true;
  meta = {
    eyebrow: 'Catálogo',
    title: 'Azúcares, aceites y más.',
    lede: 'Azúcares y jarabes, aceites vegetales y otros ingredientes, fabricados bajo el mismo control analítico y la misma documentación técnica.',
  };
} else {
  const scoped = category ? PRODUCTS.filter((product) => product.category === category) : PRODUCTS;
  items = limit ? scoped.slice(0, limit) : scoped;
  isPreview = Boolean(limit && limit < scoped.length);
  meta = category
    ? PRODUCT_CATEGORIES.find((c) => c.id === category)!
    : {
        eyebrow: 'Catálogo',
        title: 'Ingredientes para su producción.',
        lede: 'Azúcares y jarabes, aceites vegetales y otros ingredientes, fabricados bajo el mismo control analítico y la misma documentación técnica.',
      };
}
---

<section class:list={['section', 'products', surface && 'section--surface']}>
  <div class="wrap">
    <div class="products__head">
      <SectionHeading eyebrow={meta.eyebrow} level={level}>
        {meta.title}
        <p slot="lede">{meta.lede}</p>
      </SectionHeading>

      {
        isPreview && (
          <a href="/productos" class="products__all link">
            Ver catálogo completo →
          </a>
        )
      }
    </div>

    <div class="products__grid">
      {items.map((product) => <ProductCard product={product} />)}
    </div>
  </div>
</section>

<style>
  .products__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .products__all {
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
    padding-bottom: 0.3rem;
  }

  .products__grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 3vw, 2.75rem);
  }

  @media (max-width: 900px) {
    .products__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .products__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
