---
import SectionHeading from './SectionHeading.astro';
import ProductCard from './ProductCard.astro';
import { PRODUCTS } from '../data/products';

interface Props {
  limit?: number;
  surface?: boolean;
  level?: 'h1' | 'h2';
}

const { limit, surface = false, level = 'h2' } = Astro.props;
const items = limit ? PRODUCTS.slice(0, limit) : PRODUCTS;
const isPreview = Boolean(limit && limit < PRODUCTS.length);
---

<section class:list={['section', 'products', surface && 'section--surface']}>
  <div class="wrap">
    <div class="products__head">
      <SectionHeading eyebrow="Catálogo" level={level}>
        Ocho familias, una misma exigencia técnica.
        <p slot="lede">
          De los jarabes concentrados de sacarosa al azúcar en grano y los edulcorantes sólidos:
          cada familia se fabrica bajo el mismo control analítico y la misma documentación
          técnica.
        </p>
      </SectionHeading>

      {
        isPreview && (
          <a href="/productos" class="products__all link">
            Ver catálogo completo →
          </a>
        )
      }
    </div>

    <div class="products__grid">
      {items.map((product) => <ProductCard product={product} />)}
    </div>
  </div>
</section>

<style>
  .products__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .products__all {
    font-size: 0.95rem;
    font-weight: 600;
    white-space: nowrap;
    padding-bottom: 0.3rem;
  }

  .products__grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(2rem, 3vw, 2.75rem);
  }

  @media (max-width: 900px) {
    .products__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .products__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
