---
import SectionHeading from './SectionHeading.astro';

const sectors = [
  {
    title: 'Panadería y bollería',
    path: 'M4 20c1-6 4-9 8-9s7 3 8 9M8 11a4 4 0 1 1 8 0',
  },
  {
    title: 'Bebidas y refrescos',
    path: 'M9 3h6l-1 5.5c2 1 3.3 3 3.3 5.5A5.3 5.3 0 0 1 12 19a5.3 5.3 0 0 1-5.3-5c0-2.5 1.3-4.5 3.3-5.5L9 3ZM7.5 14.5h9',
  },
  {
    title: 'Sector licorero y destilados',
    path: 'M9 3h6M10 3v4.3L5.7 15A3 3 0 0 0 8.3 19.5h7.4A3 3 0 0 0 18.3 15L14 7.3V3M6.5 14.5h11',
  },
  {
    title: 'Lácteos',
    path: 'M9 3h6l.8 3.5c.9.7 1.7 1.6 1.7 3.5v8a2 2 0 0 1-2 2H8.5a2 2 0 0 1-2-2V10c0-1.9.8-2.8 1.7-3.5L9 3Zm-2.5 8h11',
  },
  {
    title: 'Conservas y salsas',
    path: 'M7 8.5c0-2.5 2.2-4.5 5-4.5s5 2 5 4.5V19a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 7 19V8.5Zm2.5-2.2L8 4M14.5 6.3 16 4',
  },
  {
    title: 'Nutrición y suplementos',
    path: 'M12 3v3.2M12 3c-3 0-5.5 2.6-5.5 6.2 0 4.4 2.6 8.1 5.5 11.8 2.9-3.7 5.5-7.4 5.5-11.8C17.5 5.6 15 3 12 3Zm0 9.5a2.7 2.7 0 1 0 0-5.4 2.7 2.7 0 0 0 0 5.4Z',
  },
] as const;
---

<section class="section sectors">
  <div class="wrap">
    <SectionHeading eyebrow="Sectores" align="center">
      Presentes en toda la cadena alimentaria.
      <p slot="lede">
        Formulamos para fabricantes de alimentos y bebidas de perfiles muy distintos, con la
        misma exigencia técnica en cada entrega.
      </p>
    </SectionHeading>

    <ul class="sectors__grid">
      {
        sectors.map((sector) => (
          <li class="sectors__item" data-reveal>
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d={sector.path} stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span>{sector.title}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sectors__grid {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--border);
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    overflow: hidden;
  }

  .sectors__item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding: 1.6rem 1.75rem;
    background: var(--paper);
    color: var(--ink);
    font-size: 1rem;
    transition: background-color 0.3s var(--ease);
  }

  .sectors__item svg {
    flex-shrink: 0;
    color: var(--accent);
  }

  .sectors__item:hover {
    background: var(--surface);
  }

  @media (max-width: 900px) {
    .sectors__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 560px) {
    .sectors__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
