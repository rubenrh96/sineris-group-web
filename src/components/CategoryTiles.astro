---
import { Image } from 'astro:assets';
import { PRODUCTS, PRODUCT_CATEGORIES } from '../data/products';

const tiles = PRODUCT_CATEGORIES.map((cat) => ({
  ...cat,
  count: PRODUCTS.filter((p) => p.category === cat.id).length,
  cover: PRODUCTS.find((p) => p.slug === cat.coverSlug)?.image,
}));
---

<ul class="tiles" data-category-tiles>
  {
    tiles.map((tile) => (
      <li data-reveal>
        <a href={`#${tile.id}`} class="tile" data-filter={tile.id}>
          {tile.cover && (
            <Image src={tile.cover} alt="" width={560} height={373} class="tile__image" />
          )}
          <span class="tile__body">
            <span class="tile__count">
              {tile.count} {tile.count === 1 ? 'producto' : 'productos'}
            </span>
            <span class="tile__title">{tile.eyebrow}</span>
            <span class="tile__short">{tile.short}</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .tiles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1rem, 2vw, 1.5rem);
  }

  .tile {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--paper);
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .tile:hover,
  .tile:focus-visible {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-soft);
  }

  .tile :global(.tile__image) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .tile:hover :global(.tile__image) {
    transform: scale(1.03);
  }

  .tile__body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.1rem 1.25rem 1.3rem;
  }

  .tile__count {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted-soft);
  }

  .tile__title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--ink);
  }

  .tile__short {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
  }

  @media (max-width: 1000px) {
    .tiles {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 520px) {
    .tiles {
      grid-template-columns: 1fr;
    }
  }
</style>
