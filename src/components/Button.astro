---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'onInk';
  arrow?: boolean;
  class?: string;
}

const { href, variant = 'primary', arrow = false, class: className = '' } = Astro.props;

const variantClass =
  variant === 'secondary' ? 'btn-secondary' : variant === 'onInk' ? 'btn-on-ink' : '';
---

<a href={href} class:list={['btn', variantClass, className]}>
  <slot />
  {
    arrow && (
      <svg
        class="btn__icon"
        width="16"
        height="16"
        viewBox="0 0 16 16"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M3.5 8h9M8.5 3.5 13 8l-4.5 4.5"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
    )
  }
</a>
