// non-essential cookies are added, and wire up a real consent banner
// before launch (this page alone does not constitute one).
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
---

<BaseLayout title="Política de cookies" description="Política de cookies de Sineris Group SLU.">
  <header class="section section--tight">
    <div class="wrap">
      <SectionHeading level="h1">Política de cookies</SectionHeading>
    </div>
  </header>

  <section class="section section--tight">
    <div class="wrap">
      <div class="prose">
        <h2>1. ¿Qué son las cookies?</h2>
        <p>
          Las cookies son pequeños archivos que un sitio web instala en el navegador del usuario
          para almacenar y recuperar información sobre su navegación.
        </p>

        <h2>2. Cookies utilizadas en este sitio</h2>
        <p>
          Este sitio web, en su configuración actual, no instala cookies de analítica ni de
          publicidad. Únicamente podría utilizar cookies técnicas estrictamente necesarias para su
          funcionamiento, que no requieren consentimiento previo.
        </p>

        <h2>3. Cómo desactivar las cookies</h2>
        <p>
          Puede permitir, bloquear o eliminar las cookies instaladas en su equipo mediante la
          configuración de su navegador. Consulte la ayuda de su navegador para más información.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
