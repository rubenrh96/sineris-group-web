---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Products from '../components/Products.astro';
import SectionHeading from '../components/SectionHeading.astro';
import CategoryTabs from '../components/CategoryTabs.astro';
import CategoryTiles from '../components/CategoryTiles.astro';
import Sectors from '../components/Sectors.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { PRODUCTS, PRODUCT_CATEGORIES } from '../data/products';
import { COMPANY } from '../data/nav';

const productSchemas = await Promise.all(
  PRODUCTS.map(async (product) => {
    const image = product.image
      ? await getImage({ src: product.image, width: 800, height: 600 })
      : undefined;
    const category = PRODUCT_CATEGORIES.find((c) => c.id === product.category);

    return {
      '@type': 'Product',
      name: product.title,
      description: product.description,
      category: category?.eyebrow ?? 'Ingredientes para la industria alimentaria',
      ...(image && { image: new URL(image.src, Astro.site).toString() }),
      brand: { '@type': 'Brand', name: COMPANY.name },
    };
  })
);

const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Catálogo de productos Sineris Group',
  itemListElement: productSchemas.map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: product,
  })),
};
---

<BaseLayout
  title="Productos"
  description="Azúcares y jarabes, aceites vegetales, fertilizantes líquidos, almidones y ácido cítrico: catálogo completo de Sineris Group."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(catalogSchema)} />
  <header id="catalogo" class="section section--tight products-page__head">
    <div class="wrap">
      <SectionHeading eyebrow="Catálogo" level="h1">
        Ingredientes para su producción.
        <p slot="lede">
          Elija una categoría para ver los productos: azúcares y jarabes, aceites vegetales,
          almidones y ácidos, y fertilizantes líquidos.
        </p>
      </SectionHeading>
    </div>
  </header>

  <CategoryTabs />

  <div class="section section--tight" data-category-tiles-wrap>
    <div class="wrap">
      <CategoryTiles />
    </div>
  </div>

  {
    PRODUCT_CATEGORIES.map((cat, index) => (
      <Products
        category={cat.id}
        level="h2"
        surface={index % 2 === 1}
      />
    ))
  }

  <Sectors />
  <FAQ />
  <CTA
    eyebrow="¿No encuentra lo que busca?"
    title="Desarrollamos formulaciones a medida."
    description="Cuéntenos la aplicación, la concentración objetivo y el volumen: nuestro equipo técnico prepara una propuesta específica."
  />
</BaseLayout>

