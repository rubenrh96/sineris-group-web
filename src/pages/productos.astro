---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Products from '../components/Products.astro';
import Sectors from '../components/Sectors.astro';
import FAQ from '../components/FAQ.astro';
import CTA from '../components/CTA.astro';
import { PRODUCTS, PRODUCT_CATEGORIES } from '../data/products';
import { COMPANY } from '../data/nav';

const productSchemas = await Promise.all(
  PRODUCTS.map(async (product) => {
    const image = product.image
      ? await getImage({ src: product.image, width: 800, height: 600 })
      : undefined;
    const category = PRODUCT_CATEGORIES.find((c) => c.id === product.category);

    return {
      '@type': 'Product',
      name: product.title,
      description: product.description,
      category: category?.eyebrow ?? 'Ingredientes para la industria alimentaria',
      ...(image && { image: new URL(image.src, Astro.site).toString() }),
      brand: { '@type': 'Brand', name: COMPANY.name },
    };
  })
);

const catalogSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Catálogo de productos Sineris Group',
  itemListElement: productSchemas.map((product, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: product,
  })),
};
---

<BaseLayout
  title="Productos"
  description="Azúcares y jarabes, aceites vegetales, almidones y ácido cítrico para la industria alimentaria: catálogo completo de Sineris Group."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(catalogSchema)} />
  <div class="products-page__spacer" />

  {
    PRODUCT_CATEGORIES.map((cat, index) => (
      <Products
        category={cat.id}
        level={index === 0 ? 'h1' : 'h2'}
        surface={index % 2 === 1}
      />
    ))
  }

  <Sectors />
  <FAQ />
  <CTA
    eyebrow="¿No encuentra lo que busca?"
    title="Desarrollamos formulaciones a medida."
    description="Cuéntenos la aplicación, la concentración objetivo y el volumen: nuestro equipo técnico prepara una propuesta específica."
  />
</BaseLayout>

<style>
  .products-page__spacer {
    padding-top: clamp(1.5rem, 4vw, 3rem);
  }
</style>
